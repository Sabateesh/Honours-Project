# Trained models are ~90 MB each. Only the one the app actually ships with is
# committed (checkpoints/vscode_tiles_2x.*, force-added below the ignore rule),
# so a fresh clone or ZIP works with no download step. Every other checkpoint
# is experimental and stays out.
checkpoints/
*.pt

# environments
.venv*/
__pycache__/
*.pyc
.pytest_cache/

# generated training data & artifacts (rebuild with comas.synthetic / comas.realpairs)
# all generated datasets, whatever they are called - these are rebuilt with
# comas.synthetic / comas.tiling and must never end up in the repo
data/
data_*/
!data_README.md
all_shots/
checkpoints/
cache/

# inference outputs
ranked*.csv
copilot_ranked.csv
holdout_*.csv
data_pos.csv
data_neg.csv

# OS / editor
.DS_Store
.vscode/
.claude/

# launchers written by the installer
Run CoMas Triage.command
Run CoMas Triage.bat
build/
*.egg-info/
config_tiles.yaml
requirements.txt
scores_vscode.json
